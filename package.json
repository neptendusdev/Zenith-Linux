{
  "name": "zenith-browser",
  "version": "1.0.0",
  "description": "Zenith - Un navigateur web moderne et léger construit avec Electron",
  "main": "src/main.js",
  "homepage": "https://github.com/neptendusdev/Zenith-Linux",
  "repository": {
    "type": "git",
    "url": "https://github.com/neptendusdev/Zenith-Linux.git"
  },
  "desktopName": "zenith-browser.desktop",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux --x64 --publish never"
  },
  "build": {
    "appId": "com.zenith.browser",
    "productName": "Zenith",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*"
    ],
    "asarUnpack": [
      "src/mcp.js"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/logo.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/logo.icns"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "tar.gz"
      ],
      "icon": "assets/logo.png",
      "syncDesktopName": true,
      "category": "Network;WebBrowser",
      "synopsis": "Navigateur web moderne et léger",
      "maintainer": "Zenith Team <noreply@zenith.local>",
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}",
      "desktop": {
        "entry": {
          "Name": "Zenith",
          "Comment": "Navigateur web moderne et léger",
          "StartupWMClass": "Zenith",
          "MimeType": "text/html;x-scheme-handler/http;x-scheme-handler/https;"
        }
      }
    },
    "deb": {
      "depends": ["libgtk-3-0", "libnotify4", "libnss3", "libxss1", "libxtst6", "xdg-utils", "libatspi2.0-0", "libuuid1", "libsecret-1-0"]
    }
  },
  "keywords": [
    "browser",
    "electron",
    "zenith",
    "web"
  ],
  "author": "Zenith Team",
  "license": "MIT",
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "26.18.0"
  },
  "allowScripts": {
    "electron@45.4.1": true,
    "electron-winstaller": false
  }
}
